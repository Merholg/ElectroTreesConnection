{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "ElectroTreesConnection Design System — Industrial Dark palette. Amber-on-dark inspired by HMI/SCADA control software. Built for electricians and facility managers working with electrical panel circuit trees. Edit this file only; do not hand-edit generated src/index.css or src/generated/tokens.tsx.",
  "color": {
    "$type": "color",
    "light": {
      "background":          { "$value": "#eef0f6", "$description": "Page background — light steel gray for light mode" },
      "foreground":          { "$value": "#1a1f2e", "$description": "Default text — deep navy" },
      "card":                { "$value": "#ffffff" },
      "cardForeground":      { "$value": "#1a1f2e" },
      "popover":             { "$value": "#ffffff" },
      "popoverForeground":   { "$value": "#1a1f2e" },
      "primary":             { "$value": "#c47a10", "$description": "Primary brand — warm amber (darker for light mode contrast)" },
      "primaryForeground":   { "$value": "#ffffff" },
      "secondary":           { "$value": "#2a3044", "$description": "Secondary — dark navy" },
      "secondaryForeground": { "$value": "#eef0f6" },
      "muted":               { "$value": "#dde1ec" },
      "mutedForeground":     { "$value": "#4a5578" },
      "accent":              { "$value": "#fde8b0", "$description": "Accent — pale amber glow" },
      "accentForeground":    { "$value": "#8a5a0a" },
      "destructive":         { "$value": "#d94040", "$description": "Danger — electrical fault red" },
      "destructiveForeground": { "$value": "#ffffff" },
      "border":              { "$value": "#b8c2d8" },
      "input":               { "$value": "#b8c2d8" },
      "ring":                { "$value": "#c47a10" },
      "chart1":              { "$value": "#c47a10" },
      "chart2":              { "$value": "#3a7fd4" },
      "chart3":              { "$value": "#2e9e5e" },
      "chart4":              { "$value": "#d94040" },
      "chart5":              { "$value": "#7c5cbf" },
      "sidebar":             { "$value": "#e4e8f2" },
      "sidebarForeground":   { "$value": "#1a1f2e" },
      "sidebarBorder":       { "$value": "#b8c2d8" },
      "sidebarPrimary":      { "$value": "#c47a10" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent":       { "$value": "#d4d9e8" },
      "sidebarAccentForeground": { "$value": "#1a1f2e" },
      "sidebarRing":         { "$value": "#c47a10" }
    },
    "dark": {
      "background":          { "$value": "#1a1f2e", "$description": "Deep navy-charcoal — primary dark surface" },
      "foreground":          { "$value": "#e0e4f0", "$description": "Light steel text" },
      "card":                { "$value": "#222840", "$description": "Card surface — slightly elevated dark" },
      "cardForeground":      { "$value": "#e0e4f0" },
      "popover":             { "$value": "#222840" },
      "popoverForeground":   { "$value": "#e0e4f0" },
      "primary":             { "$value": "#e8a020", "$description": "Primary brand — HMI amber" },
      "primaryForeground":   { "$value": "#1a1f2e" },
      "secondary":           { "$value": "#2a3352", "$description": "Secondary — medium dark navy-slate" },
      "secondaryForeground": { "$value": "#c0c8e0" },
      "muted":               { "$value": "#252c42" },
      "mutedForeground":     { "$value": "#6a78a0" },
      "accent":              { "$value": "#f0c060", "$description": "Accent — warm amber glow" },
      "accentForeground":    { "$value": "#1a1f2e" },
      "destructive":         { "$value": "#e04040", "$description": "Danger — fault/alert red" },
      "destructiveForeground": { "$value": "#ffffff" },
      "border":              { "$value": "#303858" },
      "input":               { "$value": "#2a3352" },
      "ring":                { "$value": "#e8a020" },
      "chart1":              { "$value": "#e8a020", "$description": "Amber — primary series" },
      "chart2":              { "$value": "#4a90d9", "$description": "Steel blue — secondary series" },
      "chart3":              { "$value": "#48bb78", "$description": "Circuit green — tertiary series" },
      "chart4":              { "$value": "#fc6868", "$description": "Alert red — fault/warning series" },
      "chart5":              { "$value": "#9f7aea", "$description": "Instrument violet — fifth series" },
      "sidebar":             { "$value": "#141726", "$description": "Sidebar — darkest surface, deeper than background" },
      "sidebarForeground":   { "$value": "#a8b4cc" },
      "sidebarBorder":       { "$value": "#252c42" },
      "sidebarPrimary":      { "$value": "#e8a020" },
      "sidebarPrimaryForeground": { "$value": "#1a1f2e" },
      "sidebarAccent":       { "$value": "#252c42" },
      "sidebarAccentForeground": { "$value": "#e0e4f0" },
      "sidebarRing":         { "$value": "#e8a020" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans":  { "$value": ["Inter", "sans-serif"], "$description": "Clean UI face for labels, body, and navigation" },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono":  { "$value": ["JetBrains Mono", "monospace"], "$description": "Technical values — load ratings, circuit IDs, phase data" }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": { "$value": "0.25rem", "$description": "Sharp corners — technical/industrial feel. sm/md/lg/xl derive from this." }
  },
  "spacing": {
    "$type": "dimension",
    "base": { "$value": "0.25rem" }
  }
}
